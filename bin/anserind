#!/usr/bin/env bash

VERBOSE=false

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
case "${1:-}" in
    -V|--version)
        printf '%s v%s\n' "anserind" "$(cat "$BIN_DIR/../version.txt")"
        exit 0
        ;;
esac
export ANSERIN_DIR="$(dirname "$BIN_DIR")/src"
export PATH="$BIN_DIR:$PATH"

source "$ANSERIN_DIR/scripts/caching.sh"
source "$ANSERIN_DIR/scripts/config.sh"
source "$ANSERIN_DIR/scripts/i18n.sh"

if [ -z "$MAIN_QML" ]; then
    export MAIN_QML="$(find "$ANSERIN_DIR/quickshell" -type f \( -name "Shell.qml" -o -name "Bar.qml" \) 2>/dev/null | head -n 1)"
fi

get_installed_version() {
    cat "$BIN_DIR/../version.txt"
}

show_help() {
    echo "$(t "daemon.cli.usage")"
    echo ""
    echo "$(t "daemon.cli.description")"
    echo ""
    echo "$(t "daemon.cli.commands")"
    echo "  start                       $(t "daemon.cli.cmd_start")"
    echo "  stop                        $(t "daemon.cli.cmd_stop")"
    echo "  status                      $(t "daemon.cli.cmd_status")"
    echo ""
    echo "$(t "daemon.cli.options")"
    echo "  -v, --verbose               $(t "daemon.cli.opt_verbose")"
    echo "  -V, --version               $(t "daemon.cli.opt_version")"
    echo "  -h, --help                  $(t "daemon.cli.opt_help")"
    echo ""
}

COMMAND=""
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            export ANSERIN_VERBOSE=true
            shift
            ;;
        -V|--version)
            echo "anserind v$(get_installed_version)"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        start|stop|status)
            if [ -z "$COMMAND" ]; then
                COMMAND="$1"
            fi
            shift
            ;;
        *)
            echo "$(t "daemon.cli.unknown_arg" ARG="$1")"
            show_help
            exit 1
            ;;
    esac
done

if [ -z "$COMMAND" ]; then
    COMMAND="start"
fi

PID_FILE="$QS_RUN_DIR/anserind.pid"
case "$COMMAND" in
    stop)
        mo_stop_tree "$PID_FILE"
        echo "$(t "daemon.cli.stopped")"
        ;;
    status)
        if mo_pid_valid "$PID_FILE"; then
            echo "$(t "daemon.cli.status_running" PID="$(cat "$PID_FILE")")"
        else
            echo "$(t "daemon.cli.status_stopped")"
            exit 1
        fi
        ;;
    start)
        exec 9>"$QS_RUN_DIR/anserind.lock"
        flock -n 9 || { echo "$(t "daemon.already_running")"; exit 1; }
        mo_pid_write "$PID_FILE" "$$" || exit 1
        cleanup() {
            trap - EXIT INT TERM HUP
            mo_stop_tree "$QS_RUN_DIR/focus-daemon.pid"
            mo_stop_tree "$QS_RUN_DIR/quickshell.pid"
            exit 0
        }
        trap cleanup EXIT INT TERM HUP
        # Wellbeing (its focus daemon) is gone; cleanup still stops one an older version started
        quickshell -p "$MAIN_QML" 9>&- &
        qs_pid=$!
        mo_pid_write "$QS_RUN_DIR/quickshell.pid" "$qs_pid"
        wait "$qs_pid"
        ;;
esac
