{
  "general": {
    "language": "en",
    "avatarPath": "",
    "muteSfx": false,
    "weatherInterval": 15,
    "weatherUnit": "metric"
  },
  "terminal": {
    "background": "clear",
    "blurSize": 8,
    "prompt": "hex",
    "border": "white",
    "workspace": "horizontal",
    "infiniteDesktop": {
      "toggleShortcut": "SUPER + CTRL",
      "panMode": "anserin",
      "panKeys": "SUPER + ALT",
      "navigateMode": "anserin",
      "navigateKeys": "SUPER",
      "moveMode": "anserin",
      "moveKeys": "SUPER + SHIFT",
      "resizeMode": "anserin",
      "resizeKeys": "SUPER + CTRL",
      "cellScale": 100
  },
    "scrollableTiling": {
      "windowLayout": "hyprland",
      "appsScrollable": false
    }
  },
  "launcher": {
    "position": "center",
    "width": 755
  },
  "quickactions": {
    "modules": {
      "left": ["launcher", "system", "timer", "screenshot"],
      "bottom": [],
      "right": [],
      "top": []
    }
  },
  "syspanel": {
    "clipExpandProgress": 0,
    "clipExpanded": false,
    "clipState": 1
  },
  "bar": {
    "position": "top",
    "width": 100,
    "opacity": 100,
    "style": "fill", 
    "time": {
      "format": "HH:mm:ss"
    },
    "autohide": false,
    "autohideTimeout": 1000,
    "modules": {
      "left": [
        "workspaces",
        "media" 
      ],
     "center": [
        [
          "timedate",
          "info",
          "weather"
        ]
      ],      
     "right": [
        "tray",
        [
          "kb",
          "wifi",
          "bt",
          "vol",
          "bat"
        ]
      ]
    }
  },
  "theme": {
    "fontFamily": "Adwaita Mono",
    "borderRadius": 10,
    "activePreset": "Matugen",
    "matugen": true
  },
  "idle": {
    "enabled": true,
    "actions": {
      "dim": {
        "id": "dim",
        "timeout": 150,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      },
      "dpms": {
        "id": "dpms",
        "timeout": 450,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      },
      "lock": {
        "id": "lock",
        "timeout": 300,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      },
      "suspend": {
        "id": "suspend",
        "timeout": 600,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      }
    }
  },
  "notifications": {
    "dnd": true,
    "position": "top right",
    "sound": true,
    "soundFile": ""
  },
  "display": {
    "settingsStyle": "anserin",
    "monitors": {
      "eDP-1": {
        "enabled": false,
        "scale": 1
      }
    }
  },
  "fastfetch": {
    "mode": "ascii",
    "ascii": "berserk.txt",
    "pic": "Mark.png",
    "random": true,
    "randomMode": "ascii",
    "auto": true,
    "hideLogo": false
  }
}
